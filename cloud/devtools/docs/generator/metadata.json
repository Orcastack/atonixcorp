{
  "services": {
    "compute": {
      "methods": ["create", "delete", "list"],
      "path": "/compute"
    },
    "network": {
      "methods": ["create", "delete", "list"],
      "path": "/network"
    },
    "storage": {
      "methods": ["create", "delete", "list"],
      "path": "/storage"
    },
    "swift": {
      "methods": ["createContainer", "deleteContainer", "uploadObject", "deleteObject"],
      "path": "/swift"
    },
    "identity": {
